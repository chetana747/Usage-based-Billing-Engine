# =============================================================================
# FLEXPRICE REBUILD ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Every setting is defined below. DO NOT commit actual secrets to version control.
# =============================================================================

# Deployment Mode (local / staging / production)
FLEXPRICE_DEPLOYMENT_MODE="local"

# Server Configuration
FLEXPRICE_SERVER_ADDRESS=":8080"
FLEXPRICE_ENVIRONMENT="development"
FLEXPRICE_LOG_LEVEL="info"

# =============================================================================
# PostgreSQL Database (Relational Data & Metadata)
# =============================================================================
FLEXPRICE_POSTGRES_HOST="localhost"
FLEXPRICE_POSTGRES_PORT="5432"
FLEXPRICE_POSTGRES_USER="flexprice"
FLEXPRICE_POSTGRES_PASSWORD="your-postgres-password"
FLEXPRICE_POSTGRES_DBNAME="flexprice"
FLEXPRICE_POSTGRES_SSLMODE="disable"
FLEXPRICE_POSTGRES_READER_HOST="localhost"

# =============================================================================
# ClickHouse (High-Throughput Metering & Event Aggregation)
# =============================================================================
FLEXPRICE_CLICKHOUSE_ADDRESS="localhost:9000"
FLEXPRICE_CLICKHOUSE_USERNAME="flexprice"
FLEXPRICE_CLICKHOUSE_PASSWORD="your-clickhouse-password"
FLEXPRICE_CLICKHOUSE_DATABASE="flexprice"

# =============================================================================
# Apache Kafka (Message Stream & Event Bus)
# =============================================================================
FLEXPRICE_KAFKA_BROKERS="localhost:29092"
FLEXPRICE_KAFKA_USE_SASL="false"
FLEXPRICE_KAFKA_SASL_MECHANISM="PLAIN"
FLEXPRICE_KAFKA_SASL_USER=""
FLEXPRICE_KAFKA_SASL_PASSWORD=""
FLEXPRICE_KAFKA_TOPIC="events"
FLEXPRICE_KAFKA_TOPIC_LAZY="events_lazy"
FLEXPRICE_KAFKA_CONSUMER_GROUP="events_consumer"

# Raw Event Ingestion Processing
FLEXPRICE_RAW_EVENT_CONSUMPTION_ENABLED="true"
FLEXPRICE_RAW_EVENT_CONSUMPTION_TOPIC="raw_events"
FLEXPRICE_RAW_EVENT_CONSUMPTION_OUTPUT_TOPIC="events"
FLEXPRICE_RAW_EVENT_CONSUMPTION_CONSUMER_GROUP="raw_events_consumer"
FLEXPRICE_RAW_EVENT_CONSUMPTION_RATE_LIMIT="1000"

# =============================================================================
# Authentication & RBAC
# =============================================================================
# Provider: api_key / supabase / jwt
FLEXPRICE_AUTH_PROVIDER="api_key"
FLEXPRICE_AUTH_API_KEY_HEADER="x-api-key"
FLEXPRICE_AUTH_SECRET="your-jwt-signing-secret-minimum-32-chars"
FLEXPRICE_AUTH_SUPABASE_BASE_URL=""
FLEXPRICE_AUTH_SUPABASE_SERVICE_KEY=""

# Seed Tenant & Environment
FLEXPRICE_BILLING_TENANT_ID="00000000-0000-0000-0000-000000000000"
FLEXPRICE_BILLING_ENVIRONMENT_ID="00000000-0000-0000-0000-000000000000"

# 32-Byte Hex Encryption Key for Sensitive Credential Storage
FLEXPRICE_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# =============================================================================
# Temporal Workflow Engine (Subscription Billing & Lifecycle Workflows)
# =============================================================================
FLEXPRICE_TEMPORAL_ENABLED="true"
FLEXPRICE_TEMPORAL_ADDRESS="localhost:7233"
FLEXPRICE_TEMPORAL_NAMESPACE="default"

# =============================================================================
# External Payment & Webhook Integrations
# =============================================================================
# Stripe
STRIPE_API_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Svix Webhooks
FLEXPRICE_SVIX_API_KEY=""

# Email Notification Service (Resend)
FLEXPRICE_EMAIL_ENABLED="false"
FLEXPRICE_EMAIL_RESEND_API_KEY=""

# Monitoring & Profiling
FLEXPRICE_SENTRY_ENABLED="false"
FLEXPRICE_SENTRY_DSN=""
FLEXPRICE_PYROSCOPE_ENABLED="false"
FLEXPRICE_CACHE_ENABLED="false"
